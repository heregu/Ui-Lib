local function createSortOption(modeKey, text)
	local optBtn = Instance.new("TextButton")
	optBtn.Size = UDim2.new(1, 0, 0, 25)
	optBtn.BackgroundTransparency = 1
	optBtn.Font = Enum.Font.SourceSans
	optBtn.Text = "  " .. text
	optBtn.TextColor3 = Color3.fromRGB(30, 30, 30)
	optBtn.TextSize = 12
	optBtn.TextXAlignment = Enum.TextXAlignment.Left
	optBtn.ZIndex = 31
	optBtn.Parent = sortDropdown

	optBtn.MouseEnter:Connect(function()
		optBtn.BackgroundTransparency = 0
		optBtn.BackgroundColor3 = Color3.fromRGB(0, 85, 230)
		optBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)

	optBtn.MouseLeave:Connect(function()
		optBtn.BackgroundTransparency = 1
		optBtn.TextColor3 = Color3.fromRGB(30, 30, 30)
	end)

	optBtn.Activated:Connect(function()
		currentSortMode = modeKey
		sortBtn.Text = text .. " ▼"
		sortDropdown.Visible = false
	end)
end

