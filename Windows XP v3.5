end)

local function getDevice(p)
	if p == player then
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			return "📱 Mobile"
		elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
			return "🎮 Console"
		else
			return "💻 PC"
		end
	end
	return "👤 Player"
end

local function addPlayerCard(targetPlayer)
	pcall(function()
		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, -6, 0, 68)
		card.BackgroundColor3 = Color3.fromRGB(248, 248, 248)
		card.BorderSizePixel = 0
		card.Parent = scrollList

		local cStroke = Instance.new("UIStroke")
		cStroke.Color = Color3.fromRGB(220, 220, 220)
		cStroke.Thickness = 1
		cStroke.Parent = card

		local cCorner = Instance.new("UICorner")
		cCorner.CornerRadius = UDim.new(0, 4)
		cCorner.Parent = card

		local pfp = Instance.new("ImageLabel")
		pfp.Size = UDim2.new(0, 52, 0, 52)
		pfp.Position = UDim2.new(0, 8, 0, 8)
		pfp.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
		pfp.BorderSizePixel = 0
		pfp.Image = "rbxthumb://type=AvatarHeadShot&id=" .. targetPlayer.UserId .. "&w=100&h=100"
		pfp.Parent = card

		local pfpCorner = Instance.new("UICorner")
		pfpCorner.CornerRadius = UDim.new(0, 6)
		pfpCorner.Parent = pfp

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, -72, 0, 18)
		nameLabel.Position = UDim2.new(0, 68, 0, 6)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = Enum.Font.SourceSansBold
		nameLabel.TextSize = 15
		nameLabel.TextColor3 = Color3.fromRGB(20, 20, 20)
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Text = targetPlayer.DisplayName .. " (@" .. targetPlayer.Name .. ")"
		nameLabel.Parent = card

		local joinTime = os.time() - (targetPlayer.AccountAge * 86400)
		local dateStr = os.date("%B %d, %Y", joinTime)

		local joinLabel = Instance.new("TextLabel")
		joinLabel.Size = UDim2.new(1, -72, 0, 15)
		joinLabel.Position = UDim2.new(0, 68, 0, 26)
		joinLabel.BackgroundTransparency = 1
		joinLabel.Font = Enum.Font.SourceSans
		joinLabel.TextSize = 13
		joinLabel.TextColor3 = Color3.fromRGB(100, 100, 100)
		joinLabel.TextXAlignment = Enum.TextXAlignment.Left
		joinLabel.Text = "📅 Joined: " .. dateStr
		joinLabel.Parent = card

		local devLabel = Instance.new("TextLabel")
		devLabel.Size = UDim2.new(1, -72, 0, 15)
		devLabel.Position = UDim2.new(0, 68, 0, 44)
		devLabel.BackgroundTransparency = 1
		devLabel.Font = Enum.Font.SourceSansMedium
		devLabel.TextSize = 12
		devLabel.TextColor3 = Color3.fromRGB(0, 100, 210)
		devLabel.TextXAlignment = Enum.TextXAlignment.Left
		devLabel.Text = "Device: " .. getDevice(targetPlayer)
		devLabel.Parent = card
	end)
end

local function refreshPlayerList()
	local all = Players:GetPlayers()
	countLabel.Text = "Server Players: " .. #all

	for _, child in ipairs(scrollList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	for _, p in ipairs(all) do
		addPlayerCard(p)
	end
end

Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)
refreshPlayerList()

local openTweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local closeTweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local rollTweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function switchApp(appIndex)
	homeNotePage.Visible = (appIndex == 1)
	playersPage.Visible = (appIndex == 2)
	scriptBloxPage.Visible = (appIndex == 3)

	local titles = {
		"System Hub - Home Note",
		"System Hub - Players Directory",
		"System Hub - ScriptBlox Browser"
	}
	titleText.Text = titles[appIndex]

	local buttons = {tbHomeBtn, tbPlayersBtn, tbScriptBtn}
	for i, btn in ipairs(buttons) do
		if i == appIndex then
			btn.BackgroundColor3 = Color3.fromRGB(25, 75, 175)
		else
			btn.BackgroundColor3 = Color3.fromRGB(50, 120, 240)
		end
	end

	if not mainWindow.Visible or uiScale.Scale == 0 then
		mainWindow.Visible = true
		uiScale.Scale = 0
		TweenService:Create(uiScale, openTweenInfo, { Scale = 1 }):Play()
	end
end

tbHomeBtn.Activated:Connect(function() switchApp(1) end)
tbPlayersBtn.Activated:Connect(function() switchApp(2) end)
tbScriptBtn.Activated:Connect(function() switchApp(3) end)

TweenService:Create(uiScale, openTweenInfo, { Scale = 1 }):Play()

closeBtn.MouseEnter:Connect(function() closeBtn.BackgroundColor3 = Color3.fromRGB(255, 95, 75) end)
closeBtn.MouseLeave:Connect(function() closeBtn.BackgroundColor3 = Color3.fromRGB(224, 67, 44) end)

minBtn.MouseEnter:Connect(function() minBtn.BackgroundColor3 = Color3.fromRGB(75, 145, 255) end)
minBtn.MouseLeave:Connect(function() minBtn.BackgroundColor3 = Color3.fromRGB(43, 115, 228) end)

closeBtn.Activated:Connect(function()
	local closeTw = TweenService:Create(uiScale, closeTweenInfo, { Scale = 0 })
	closeTw:Play()
	closeTw.Completed:Connect(function()
		mainWindow.Visible = false
	end)
end)

startBtn.Activated:Connect(function()
	if not mainWindow.Visible or uiScale.Scale == 0 then
		mainWindow.Visible = true
		uiScale.Scale = 0
		TweenService:Create(uiScale, openTweenInfo, { Scale = 1 }):Play()
	else
		local closeTw = TweenService:Create(uiScale, closeTweenInfo, { Scale = 0 })
		closeTw:Play()
		closeTw.Completed:Connect(function()
			mainWindow.Visible = false
		end)
	end
end)

local isMinimized = false
minBtn.Activated:Connect(function()
	isMinimized = not isMinimized
	local targetHeight = isMinimized and 30 or windowHeight
	TweenService:Create(mainWindow, rollTweenInfo, { Size = UDim2.new(0, windowWidth, 0, targetHeight) }):Play()
end)

local isDragging = false
local dragStartPos = nil
local frameStartPos = nil

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = true
		dragStartPos = input.Position
		frameStartPos = mainWindow.Position
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDragging and dragStartPos and frameStartPos and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStartPos
		mainWindow.Position = UDim2.new(
			frameStartPos.X.Scale,
			frameStartPos.X.Offset + delta.X,
			frameStartPos.Y.Scale,
			frameStartPos.Y.Offset + delta.Y
		)
	end
end)
