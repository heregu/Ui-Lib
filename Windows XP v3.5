local function fetchAndSortScripts(query)
	for _, child in ipairs(scriptScrollList:GetChildren()) do
		if child:IsA("Frame") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local encoded = HttpService:UrlEncode(query)
	local url = "https://scriptblox.com/api/script/search?q=" .. encoded .. "&page=1"
	if currentSortMode == "free" then
		url = url .. "&mode=free"
	end

	local success, response = pcall(function()
		return game:HttpGet(url)
	end)

	if success then
		local data = HttpService:JSONDecode(response)
		if data and data.result and data.result.scripts then
			local scripts = data.result.scripts

			if currentSortMode == "views" then
				table.sort(scripts, function(a, b)
					return (a.views or 0) > (b.views or 0)
				end)
			elseif currentSortMode == "likes" then
				table.sort(scripts, function(a, b)
					return (a.likeCount or a.likes or 0) > (b.likeCount or b.likes or 0)
				end)
			elseif currentSortMode == "dislikes" then
				table.sort(scripts, function(a, b)
					return (a.dislikeCount or a.dislikes or 0) < (b.dislikeCount or b.dislikes or 0)
				end)
			end

			if #scripts > 0 then
				for _, sObj in ipairs(scripts) do
					addScriptCard(sObj)
				end
			else
				local emptyLbl = Instance.new("TextLabel")
				emptyLbl.Size = UDim2.new(1, 0, 0, 40)
				emptyLbl.BackgroundTransparency = 1
				emptyLbl.Font = Enum.Font.SourceSans
				emptyLbl.TextSize = 14
				emptyLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
				emptyLbl.Text = "No scripts found for: " .. query
				emptyLbl.Parent = scriptScrollList
			end
		end
	end
end

searchBtn.Activated:Connect(function()
	if searchBox.Text ~= "" then
		fetchAndSortScripts(searchBox.Text)
	end
end)

searchBox.FocusLost:Connect(function(enterPressed)
	if enterPressed and searchBox.Text ~= "" then
		fetchAndSortScripts(searchBox.Text)
